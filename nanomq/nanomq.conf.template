# nanoMQ Configuration File
#
# This is a TEMPLATE, not the final config. `docker-entrypoint.sh` renders it into
# /etc/nanomq/nanomq.conf at container start, substituting the placeholders below with
# values from the MQTT_BROKER_HTTP_PASSWORD / MQTT_WEBHOOK_SECRET environment variables
# (sourced from .env). Do not put real secrets in this file — it is committed to git.

# MQTT TCP Listener
mqtt {
    listener {
        bind = "0.0.0.0:1883"
        max_connections = 1024
    }
    allow_anonymous = false
}

# MQTT over TLS Listener (disabled by default)
# mqtt_tls {
#     listener {
#         bind = "0.0.0.0:8883"
#         certfile = "/etc/nanomq/certs/server.crt"
#         keyfile = "/etc/nanomq/certs/server.key"
#         cacertfile = "/etc/nanomq/certs/ca.crt"
#     }
# }

# WebSocket Listener
websocket {
    listener {
        bind = "0.0.0.0:8081/mqtt"
        max_connections = 1024
    }
}

# HTTP API Server
http_server {
    port = 8001
    limit_conn = 32
    username = "nmqadmin"
    password = "__MQTT_BROKER_HTTP_PASSWORD__"
}

# Async webhook — fires on client connect and message publish.
# NanoMQ 0.24.14 fixed the webhook memory (FD) leak that previously caused the
# HTTP API to become unresponsive after ~45h under load (webhook_inproc.c).
# Both events are now safe to enable.
#
# on_client_connected: last_seen is also updated in /api/mqtt/auth (belt-and-suspenders).
# on_message_publish: populates mqtt_device_topics for the topic autocomplete UI.
webhook {
    url = "http://core:3000/api/mqtt/webhook"
    headers.content-type = "application/json"
    headers.connection = "close"
    # Shared secret so core can verify this call actually came from the broker and not
    # from an internet client hitting the endpoint directly through front's /api/* proxy.
    # Must match MQTT_WEBHOOK_SECRET in core's environment (docker-compose.yml / .env).
    headers.x-nanomq-secret = "__MQTT_WEBHOOK_SECRET__"
    body.encoding = plain
    pool_size = 4

    events = [
        {
            event = "on_message_publish"
        }
    ]
}

# Authentication via HTTP webhook
auth {
    http_auth {
        auth_req {
            url = "http://core:3000/api/mqtt/auth"
            method = "POST"
            headers {
                content-type = "application/json"
                connection = "close"
            }
            params = {username = "%u", password = "%P", clientid = "%c"}
        }
        # ACL hook removed — it fired on every PUBLISH/SUBSCRIBE which caused
        # NanoMQ's HTTP worker threads to saturate when core was temporarily
        # unavailable (e.g. during rebuild). Topic tracking is now handled via
        # the auth_req (on CONNECT) and MQTT subscription in the core service.
        timeout = 10s
    }
}

# Logging
log {
    level = "info"
}
