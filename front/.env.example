# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Override the API proxy target used by `npm run dev` (front/vite.config.js) — only needed
# if core is remapped to a non-default host port (e.g. to avoid a port conflict).
VITE_API_URL=http://localhost:3000

# Override the Vite dev/preview server port — only needed if 5174 collides with something
# else on this machine.
FRONT_DEV_PORT=5174

# Add other environment variables as needed
